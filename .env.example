# Cozivara Living Environment Variables
# Copy this file to .env and configure your keys if integrating external services.

# Site URL
SITE_URL=https://cozivaraliving.com

# Optional: Server-side AI Image Generation API
# Keep all secret keys strictly on the server side (never prefix with PUBLIC_).
# Supported future providers: OpenAI DALL-E 3, Stability AI, Replicate
OPENAI_API_KEY=your_openai_api_key_here
STABILITY_API_KEY=your_stability_api_key_here

# Optional site ownership verification tokens (copy the exact values from each service).
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_PINTEREST_VERIFICATION=

# Optional: override the Pinterest profile URL already set for the site.
PUBLIC_PINTEREST_PROFILE_URL=https://www.pinterest.com/cozivaraliving2495/_profile/

# AdSense: set the exact ca-pub ID from your AdSense account after adding this site.
# Auto ads remain off until you explicitly set PUBLIC_ADSENSE_AUTO_ADS=true.
PUBLIC_ADSENSE_CLIENT_ID=
PUBLIC_ADSENSE_AUTO_ADS=false
