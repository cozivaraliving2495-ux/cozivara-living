# Cozivara Living Environment Variables
# Copy this file to .env and configure your keys if integrating external services.

# Site URL
SITE_URL=https://cozivaraliving.com

# Optional: Server-side AI Image Generation API
# Keep all secret keys strictly on the server side (never prefix with PUBLIC_).
# Supported future providers: OpenAI DALL-E 3, Stability AI, Replicate
OPENAI_API_KEY=your_openai_api_key_here
STABILITY_API_KEY=your_stability_api_key_here
