---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  authorName?: string;
  canonicalUrl?: string;
}

const {
  title = 'Cozivara Living | Make Room for Beautiful Living',
  description = 'Cozivara Living is your trusted destination for warm organic home decor, small space styling secrets, budget interior ideas, and mindful home organization.',
  image = 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1200&q=80',
  type = 'website',
  publishDate,
  authorName = 'Cozivara Editorial Team',
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteUrl = 'https://cozivaraliving.com';
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// WebSite & Organization Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cozivara Living',
  alternateName: 'Cozivara Home & Living',
  url: siteUrl,
  description: 'Make room for beautiful living. Warm organic neutral home decor, budget styling, and clutter-free living tips.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/blog?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Cozivara Living',
  url: siteUrl,
  logo: `${siteUrl}/images/logo.jpg`,
  email: 'cozivaraliving2495@gmail.com',
  sameAs: [
    'https://pinterest.com',
    'https://instagram.com',
    'https://facebook.com',
    'https://youtube.com'
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook / Pinterest Rich Pins -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Cozivara Living" />
    <meta property="og:locale" content="en_US" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {authorName && <meta property="article:author" content={authorName} />}

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Pinterest Rich Pin Verification & Domain Claim Tag -->
    <meta name="p:domain_verify" content="cozivaraliving_pinterest_verification" />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Slot for Page-Specific Head Additions (e.g. Article Schema) -->
    <slot name="head" />

    <!-- Google AdSense Auto Ads Script (Async & Non-blocking) -->
    <script 
      async 
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" 
      crossorigin="anonymous"
    ></script>
  </head>

  <body class="min-h-screen flex flex-col bg-cozi-bg text-cozi-charcoal selection:bg-cozi-olive selection:text-white antialiased">
    
    <!-- Top Announcement Bar -->
    <AnnouncementBar />

    <!-- Sticky Navigation Header -->
    <Header currentPath={Astro.url.pathname} />

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Professional Brand Footer -->
    <Footer />

    <!-- Quick Search Modal (Cmd+K / Search Icon) -->
    <SearchModal />

  </body>
</html>
