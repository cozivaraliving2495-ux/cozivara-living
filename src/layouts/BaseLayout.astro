---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  authorName?: string;
  canonicalUrl?: string;
  robots?: string;
}

const {
  title = 'Cozivara Living | Make Room for Beautiful Living',
  description = 'Cozivara Living shares practical home decor ideas, small-space styling, and approachable room-planning inspiration.',
  image = 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1200&q=80',
  type = 'website',
  publishDate,
  authorName = 'Cozivara Editorial Team',
  canonicalUrl,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const siteUrl = 'https://cozivaraliving.com';
const pageCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const pinterestVerification = import.meta.env.PUBLIC_PINTEREST_VERIFICATION?.trim();
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID?.trim() || '';
const adsenseClientIdIsValid = /^ca-pub-\d{16}$/.test(adsenseClientId);
const adsenseAutoAdsEnabled = adsenseClientIdIsValid && import.meta.env.PUBLIC_ADSENSE_AUTO_ADS === 'true';

// WebSite & Organization Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cozivara Living',
  alternateName: 'Cozivara Home & Living',
  url: siteUrl,
  description: 'Make room for beautiful living. Warm organic neutral home decor, budget styling, and clutter-free living tips.',
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Cozivara Living',
  url: siteUrl,
  logo: `${siteUrl}/images/logo.jpg`,
  email: 'cozivaraliving2495@gmail.com',
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageCanonicalUrl} />
    <meta name="robots" content={robots} />

    <!-- Open Graph / Facebook / Pinterest Rich Pins -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Cozivara Living" />
    <meta property="og:locale" content="en_US" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {authorName && <meta property="article:author" content={authorName} />}

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageCanonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {pinterestVerification && <meta name="p:domain_verify" content={pinterestVerification} />}
    {adsenseClientIdIsValid && <meta name="google-adsense-account" content={adsenseClientId} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    {adsenseAutoAdsEnabled && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
        crossorigin="anonymous"
      />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Slot for Page-Specific Head Additions (e.g. Article Schema) -->
    <slot name="head" />

  </head>

  <body class="min-h-screen flex flex-col bg-cozi-bg text-cozi-charcoal selection:bg-cozi-olive selection:text-white antialiased">
    
    <!-- Top Announcement Bar -->
    <AnnouncementBar />

    <!-- Sticky Navigation Header -->
    <Header currentPath={Astro.url.pathname} />

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Professional Brand Footer -->
    <Footer />

    <!-- Quick Search Modal (Cmd+K / Search Icon) -->
    <SearchModal />

  </body>
</html>
