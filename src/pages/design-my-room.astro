---
// src/pages/design-my-room.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { RoomDesignerEntry } from '../components/RoomDesignerEntry';

const title = '3D Design My Room Planner | Cozivara Living';
const description = 'Arrange furniture in an interactive 3D room planner. Adjust room dimensions, wall colors, flooring, and furniture placement.';
---

<BaseLayout title={title} description={description}>
  <div class="py-4">
    <!-- Client-only interactive 3D application -->
    <RoomDesignerEntry client:only="react">
      <section slot="fallback" class="mx-auto flex min-h-[60vh] max-w-7xl items-center justify-center px-4 py-10 sm:px-6 lg:px-8">
        <div class="max-w-2xl rounded-3xl border border-cozi-border bg-white p-8 text-center shadow-soft sm:p-12">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-cozi-olive">Interactive 3D Room Planner</p>
          <h1 class="font-serif text-3xl font-bold text-cozi-charcoal sm:text-4xl">Design My Room in 3D</h1>
          <p class="mt-4 text-sm leading-relaxed text-cozi-charcoal/70 sm:text-base">
            Plan a living room, bedroom, home office, or dining room. Set dimensions, choose walls and flooring, and arrange furniture in an interactive 3D workspace.
          </p>
          <p class="mt-5 text-xs text-cozi-charcoal/55" data-planner-status role="status" aria-live="polite">Loading the room planner…</p>
          <button type="button" data-planner-retry hidden class="mt-4 rounded-full bg-cozi-olive px-5 py-2.5 text-sm font-semibold text-white hover:bg-cozi-olive-dark">
            Reload the planner
          </button>
        </div>
      </section>
    </RoomDesignerEntry>
  </div>
</BaseLayout>

<script>
  const plannerIsland = document.querySelector('astro-island[client="only"]');
  const plannerStatus = plannerIsland?.querySelector<HTMLElement>('[data-planner-status]');
  const plannerRetry = plannerIsland?.querySelector<HTMLButtonElement>('[data-planner-retry]');

  if (plannerIsland && plannerStatus && plannerRetry) {
    const loadingTimeout = window.setTimeout(() => {
      if (!plannerIsland.hasAttribute('ssr')) return;

      plannerStatus.textContent = 'The planner is taking longer than expected. Check your connection and try again.';
      plannerRetry.hidden = false;
    }, 12000);

    plannerIsland.addEventListener('astro:hydrate', () => window.clearTimeout(loadingTimeout), { once: true });
    plannerRetry.addEventListener('click', () => window.location.reload());
  }
</script>
