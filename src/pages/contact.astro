---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Cozivara Living"
  description="Have a decor question, brand collaboration inquiry, or feedback for the Cozivara Living team? Get in touch with us at cozivaraliving2495@gmail.com."
>
  <!-- Contact Hero -->
  <section class="bg-[#F6F1EA] py-14 sm:py-16 border-b border-cozi-border/70">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-semibold tracking-[0.25em] uppercase text-cozi-charcoal/70 block mb-2">
        WE'D LOVE TO HEAR FROM YOU
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-cozi-charcoal tracking-tight mb-4">
        Get in Touch
      </h1>
      <p class="text-base sm:text-lg text-cozi-charcoal/80 max-w-xl mx-auto">
        Have questions about our guides, home styling tips, or partnership opportunities? Reach out and we'll be delighted to assist.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-16 sm:py-20 bg-cozi-bg">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        
        <!-- Left: Minimalist Contact Form (7 cols) -->
        <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-3xl border border-cozi-border shadow-soft">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-cozi-charcoal mb-2">Send Us a Message</h2>
          <p class="text-xs sm:text-sm text-cozi-charcoal/70 mb-8">
            On our Netlify-hosted site, this form sends your message to our contact inbox. While testing locally, it opens an email draft instead. Please review our <a href="/privacy-policy" class="underline underline-offset-2 text-cozi-olive">Privacy Policy</a> before sending.
          </p>

          <form id="contact-form" name="contact" method="POST" action="/contact-success" data-netlify="true" data-netlify-honeypot="bot-field" class="space-y-5">
            <input type="hidden" name="form-name" value="contact" />
            <div class="hidden" aria-hidden="true">
              <label for="bot-field">Leave this field empty</label>
              <input id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="full-name" class="block text-xs font-semibold uppercase tracking-wider text-cozi-charcoal/75 mb-1.5">Your Name</label>
                <input 
                  type="text" 
                  id="full-name" 
                  name="fullName" 
                  autocomplete="name"
                  maxlength="120"
                  placeholder="e.g. Sarah Jenkins"
                  required 
                  class="w-full px-4 py-3 rounded-xl border border-cozi-border text-sm text-cozi-charcoal focus:outline-hidden focus:border-cozi-olive focus:ring-2 focus:ring-cozi-olive/20 transition-all"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-cozi-charcoal/75 mb-1.5">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  autocomplete="email"
                  maxlength="254"
                  placeholder="name@example.com"
                  required 
                  class="w-full px-4 py-3 rounded-xl border border-cozi-border text-sm text-cozi-charcoal focus:outline-hidden focus:border-cozi-olive focus:ring-2 focus:ring-cozi-olive/20 transition-all"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-cozi-charcoal/75 mb-1.5">Subject</label>
              <select 
                id="subject" 
                name="subject" 
                class="w-full px-4 py-3 rounded-xl border border-cozi-border text-sm text-cozi-charcoal focus:outline-hidden focus:border-cozi-olive focus:ring-2 focus:ring-cozi-olive/20 bg-white"
              >
                <option value="decor-question">Home Decor Question / Feedback</option>
                <option value="brand-collaboration">Brand Collaboration & Partnerships</option>
                <option value="media-press">Media & Press Inquiries</option>
                <option value="general">General Support</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-cozi-charcoal/75 mb-1.5">Your Message</label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                maxlength="5000"
                placeholder="Share your question, project idea, or collaboration details..."
                required 
                class="w-full px-4 py-3 rounded-xl border border-cozi-border text-sm text-cozi-charcoal focus:outline-hidden focus:border-cozi-olive focus:ring-2 focus:ring-cozi-olive/20 transition-all"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-cozi-olive hover:bg-cozi-olive-dark text-white font-medium text-sm transition-all duration-300 shadow-sm hover:shadow-md cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
            <p id="contact-form-status" class="mt-3 text-xs text-cozi-charcoal/70" role="status" aria-live="polite"></p>
          </form>

        </div>

        <!-- Right: "Get in Touch" Info Card (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Direct Details Card -->
          <div class="bg-white p-8 rounded-3xl border border-cozi-border shadow-soft space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-cozi-olive/15 text-cozi-olive flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <span class="text-[10px] font-semibold tracking-widest uppercase text-cozi-olive block">Official Contact</span>
                <h3 class="font-serif text-xl font-bold text-cozi-charcoal">Get in Touch</h3>
              </div>
            </div>

            <!-- Email Detail -->
            <div class="pt-4 border-t border-cozi-border/70 space-y-1">
              <p class="text-xs font-semibold uppercase tracking-wider text-cozi-charcoal/60">Official Email</p>
              <a 
                href="mailto:cozivaraliving2495@gmail.com" 
                class="font-sans text-base sm:text-lg font-semibold text-cozi-olive hover:text-cozi-olive-dark underline underline-offset-4 break-all transition-colors"
              >
                cozivaraliving2495@gmail.com
              </a>
            </div>

            <!-- Response Time -->
            <div class="pt-4 border-t border-cozi-border/70 flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-cozi-cream text-cozi-olive flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-cozi-charcoal">Response Time</p>
                <p class="text-xs text-cozi-charcoal/75 leading-relaxed mt-0.5">
                Email us directly for questions and feedback.
                </p>
              </div>
            </div>

            <!-- Collaboration Note -->
            <div class="pt-4 border-t border-cozi-border/70 flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-cozi-cream text-cozi-olive flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
                  <path d="M20 6L9 17l-5-5"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-cozi-charcoal">Collaborations & Inquiries</p>
                <p class="text-xs text-cozi-charcoal/75 leading-relaxed mt-0.5">
                  For brand collaborations, media inquiries, or general home decor questions, feel free to drop us a message!
                </p>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');

  const query = new URLSearchParams(window.location.search);
  if (query.get('topic') === 'newsletter') {
    const subjectField = document.getElementById('subject');
    const messageField = document.getElementById('message');
    if (subjectField instanceof HTMLSelectElement) subjectField.value = 'general';
    if (messageField instanceof HTMLTextAreaElement) {
      messageField.value = 'I would like to hear when the Cozivara Living newsletter launches.';
    }
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (e) => {
      if (!['localhost', '127.0.0.1'].includes(window.location.hostname)) return;
      e.preventDefault();
      const data = new FormData(form);
      const subjectLabels = {
        'decor-question': 'Home Decor Question / Feedback',
        'brand-collaboration': 'Brand Collaboration & Partnerships',
        'media-press': 'Media & Press Inquiry',
        general: 'General Support',
      };
      const selectedSubject = String(data.get('subject') || 'general');
      const subject = `[Cozivara Living] ${subjectLabels[selectedSubject] || subjectLabels.general}`;
      const body = [
        `Name: ${String(data.get('fullName') || '')}`,
        `Email: ${String(data.get('email') || '')}`,
        '',
        String(data.get('message') || ''),
      ].join('\n');
      const status = document.getElementById('contact-form-status');
      if (status) status.textContent = 'Local preview: opening your email app. Please review the draft and send it there.';
      window.location.href = `mailto:cozivaraliving2495@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
