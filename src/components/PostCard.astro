---
// src/components/PostCard.astro
import type { BlogPost } from '../data/posts';
import PinterestSaveButton from './PinterestSaveButton.astro';

interface Props {
  post: BlogPost;
  aspect?: 'video' | 'pin' | 'square';
}

const { post, aspect = 'video' } = Astro.props;

const aspectClasses = {
  video: 'aspect-[16/10]',
  pin: 'aspect-[2/3]',
  square: 'aspect-square',
};

const postUrl = `/blog/${post.slug}`;
---

<article class="group bg-white rounded-2xl overflow-hidden border border-cozi-border shadow-soft hover:shadow-hover transition-all duration-300 flex flex-col h-full">
  <!-- Image Container with Pinterest Save Button -->
  <div class="pin-container relative overflow-hidden bg-cozi-cream">
    <a href={postUrl} class="block overflow-hidden">
      <img 
        src={post.featuredImage} 
        alt={post.imageAlt || post.title} 
        class={`w-full ${aspectClasses[aspect]} object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105`}
        width="600"
        height="375"
        loading="lazy"
      />
    </a>

    <!-- Hover Pinterest Save Button -->
    <PinterestSaveButton 
      url={`https://cozivaraliving.com${postUrl}`}
      media={post.pinImage || post.featuredImage}
      description={post.pinterestDescription || post.title}
    />
  </div>

  <!-- Content Container -->
  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    
    <!-- Category Badge -->
    <div class="mb-3">
      <a 
        href={`/category/${post.categorySlug}`} 
        class={`inline-block px-2.5 py-1 rounded-md text-[11px] font-semibold tracking-wider uppercase ${post.categoryBadgeBg} ${post.categoryBadgeText} transition-opacity hover:opacity-85`}
      >
        {post.category}
      </a>
    </div>

    <!-- Title -->
    <h3 class="font-serif text-lg sm:text-xl font-bold text-cozi-charcoal group-hover:text-cozi-olive transition-colors leading-snug mb-2.5">
      <a href={postUrl} class="line-clamp-2">
        {post.title}
      </a>
    </h3>

    <!-- Excerpt -->
    <p class="font-sans text-xs sm:text-sm text-cozi-charcoal/70 line-clamp-2 mb-4 leading-relaxed flex-grow">
      {post.excerpt}
    </p>

    <!-- Meta Details: Date & Read Time -->
    <div class="pt-3 border-t border-cozi-border/60 flex items-center justify-between text-[11px] text-cozi-charcoal/60 font-medium">
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>{post.publishDate}</span>
      </div>

      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{post.readTime}</span>
      </span>
    </div>

  </div>
</article>
