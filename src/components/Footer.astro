---
// src/components/Footer.astro
import { CATEGORIES } from '../data/categories';

const currentYear = new Date().getFullYear();
---

<footer class="bg-cozi-footer text-cozi-bg pt-16 pb-12 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Footer Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand Profile (4 columns) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="flex items-center gap-3 group" aria-label="Cozivara Living Home">
          <div class="relative w-12 h-12 rounded-full overflow-hidden border border-white/20 p-0.5 bg-white/10">
            <img 
              src="/images/logo.jpg" 
              alt="Cozivara Living" 
              class="w-full h-full object-cover rounded-full"
              width="48"
              height="48"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-serif text-2xl font-bold tracking-tight text-white leading-none">
              Cozivara
            </span>
            <span class="font-sans text-[10px] tracking-[0.25em] uppercase text-white/70 font-semibold mt-1">
              LIVING
            </span>
          </div>
        </a>

        <p class="font-sans text-sm text-white/75 leading-relaxed max-w-sm pt-2">
          Make room for beautiful living. Thoughtful home decor guides, small apartment ideas, and mindful organization for real life homes.
        </p>
      </div>

      <!-- Quick Links (2 columns) -->
      <div class="lg:col-span-2 sm:pl-4">
        <h3 class="font-serif text-base font-bold text-white mb-4">Quick Links</h3>
        <ul class="space-y-2.5 text-sm text-white/75">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">All Articles</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Categories Links (3 columns) -->
      <div class="lg:col-span-3">
        <h3 class="font-serif text-base font-bold text-white mb-4">Explore Categories</h3>
        <ul class="space-y-2.5 text-sm text-white/75">
          {CATEGORIES.map((cat) => (
            <li>
              <a href={`/category/${cat.slug}`} class="hover:text-white transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact & Editorial Support (3 columns) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-serif text-base font-bold text-white mb-4">Contact & Support</h3>
        <p class="text-xs text-white/75 leading-relaxed">
          Questions, styling suggestions, or brand collaborations? Reach out directly:
        </p>
        <a 
          href="mailto:cozivaraliving2495@gmail.com" 
          class="inline-block text-xs font-semibold text-cozi-sand hover:text-white underline underline-offset-4 break-all transition-colors"
        >
          cozivaraliving2495@gmail.com
        </a>
        <p class="text-[11px] text-white/60">
          We welcome questions and feedback by email.
        </p>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-white/60 gap-4">
      <p>© {currentYear} Cozivara Living. All rights reserved.</p>
      
      <div class="flex items-center space-x-6 flex-wrap gap-y-2">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/about#editorial-policy" class="hover:text-white transition-colors">Editorial Disclosure</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>

  </div>
</footer>
