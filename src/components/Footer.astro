---
// src/components/Footer.astro
import { CATEGORIES } from '../data/categories';

const currentYear = 2026;
---

<footer class="bg-cozi-footer text-cozi-bg pt-16 pb-12 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Footer Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand Profile (4 columns) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="flex items-center gap-3 group" aria-label="Cozivara Living Home">
          <div class="relative w-12 h-12 rounded-full overflow-hidden border border-white/20 p-0.5 bg-white/10">
            <img 
              src="/images/logo.jpg" 
              alt="Cozivara Living" 
              class="w-full h-full object-cover rounded-full"
              width="48"
              height="48"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-serif text-2xl font-bold tracking-tight text-white leading-none">
              Cozivara
            </span>
            <span class="font-sans text-[10px] tracking-[0.25em] uppercase text-white/70 font-semibold mt-1">
              LIVING
            </span>
          </div>
        </a>

        <p class="font-sans text-sm text-white/75 leading-relaxed max-w-sm pt-2">
          Make room for beautiful living. Thoughtful home decor guides, small apartment ideas, and mindful organization for real life homes.
        </p>

        <!-- Social Icons in Footer -->
        <div class="flex items-center space-x-3 pt-2">
          <a 
            href="https://pinterest.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-[#E60023] hover:text-white flex items-center justify-center transition-all duration-300"
            aria-label="Pinterest"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026l.032-.026z"/>
            </svg>
          </a>
          <a 
            href="https://instagram.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-[#E4405F] hover:text-white flex items-center justify-center transition-all duration-300"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.79-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links (2 columns) -->
      <div class="lg:col-span-2 sm:pl-4">
        <h3 class="font-serif text-base font-bold text-white mb-4">Quick Links</h3>
        <ul class="space-y-2.5 text-sm text-white/75">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">All Articles</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Categories Links (3 columns) -->
      <div class="lg:col-span-3">
        <h3 class="font-serif text-base font-bold text-white mb-4">Explore Categories</h3>
        <ul class="space-y-2.5 text-sm text-white/75">
          {CATEGORIES.map((cat) => (
            <li>
              <a href={`/category/${cat.slug}`} class="hover:text-white transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact & Editorial Support (3 columns) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-serif text-base font-bold text-white mb-4">Contact & Support</h3>
        <p class="text-xs text-white/75 leading-relaxed">
          Questions, styling suggestions, or brand collaborations? Reach out directly:
        </p>
        <a 
          href="mailto:cozivaraliving2495@gmail.com" 
          class="inline-block text-xs font-semibold text-cozi-sand hover:text-white underline underline-offset-4 break-all transition-colors"
        >
          cozivaraliving2495@gmail.com
        </a>
        <p class="text-[11px] text-white/60">
          Response time: 24–48 business hours.
        </p>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-white/60 gap-4">
      <p>© {currentYear} Cozivara Living. All rights reserved.</p>
      
      <div class="flex items-center space-x-6 flex-wrap gap-y-2">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/about#editorial-policy" class="hover:text-white transition-colors">Affiliate Disclosure</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>

  </div>
</footer>
