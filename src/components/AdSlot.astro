---
// src/components/AdSlot.astro
interface Props {
  position?: 'top' | 'in-article' | 'sidebar' | 'bottom';
  slotId?: string;
  adClient?: string;
  className?: string;
  preview?: boolean;
}

const { 
  position = 'top', 
  slotId = '1234567890', 
  adClient = 'ca-pub-XXXXXXXXXXXXXXXX', 
  className = '',
  preview = false 
} = Astro.props;

// Standard sizing & classes per position
const positionStyles = {
  'top': 'w-full max-w-[728px] min-h-[90px] my-6',
  'in-article': 'w-full max-w-[728px] min-h-[250px] my-8',
  'sidebar': 'w-full max-w-[300px] min-h-[250px] sm:min-h-[600px] my-4 sticky top-28',
  'bottom': 'w-full max-w-[728px] min-h-[90px] my-8',
};
---

<div class:list={[
  "ad-slot-wrapper flex flex-col items-center justify-center mx-auto overflow-hidden",
  positionStyles[position],
  className
]}>
  <!-- AdSense Compliance Label -->
  <span class="text-[10px] tracking-widest uppercase text-cozi-charcoal/40 font-sans mb-1 select-none">
    Advertisement
  </span>

  <!-- Live Ad Container -->
  <div class="relative w-full flex items-center justify-center rounded-xl bg-cozi-cream/40 border border-cozi-border/50 p-2 overflow-hidden">
    
    {preview ? (
      <!-- Preview / Placeholder mode for layout inspection -->
      <div class="w-full flex flex-col items-center justify-center py-6 px-4 text-center border border-dashed border-cozi-taupe/40 rounded-lg">
        <div class="w-7 h-7 rounded-full bg-cozi-olive/15 text-cozi-olive flex items-center justify-center mb-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <p class="text-xs font-semibold text-cozi-charcoal/70">Google AdSense Placement ({position})</p>
        <p class="text-[11px] text-cozi-charcoal/50">Slot ID: {slotId}</p>
      </div>
    ) : (
      <!-- Real Google AdSense Tag -->
      <ins 
        class="adsbygoogle block w-full text-center"
        style="display:block"
        data-ad-client={adClient}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    )}

  </div>
</div>

<!-- Asynchronous AdSense loader -->
<script is:inline>
  (function() {
    try {
      if (typeof window !== 'undefined' && window.adsbygoogle) {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      }
    } catch (e) {
      // Graceful fallback if adblock is active
    }
  })();
</script>
