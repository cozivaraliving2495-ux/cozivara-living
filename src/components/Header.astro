---
// src/components/Header.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Small Spaces', href: '/category/small-spaces' },
  { name: 'Budget Decor', href: '/category/budget-decor' },
  { name: 'Home Organization', href: '/category/home-organization' },
  { name: 'Bedroom', href: '/category/bedroom-ideas' },
  { name: 'Lifestyle', href: '/category/lifestyle' },
  { name: 'About', href: '/about' },
];
---

<header class="sticky top-0 z-40 bg-cozi-bg/95 backdrop-blur-md border-b border-cozi-border/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Branding (Neatly aligned) -->
      <a href="/" class="flex items-center gap-3.5 group shrink-0" aria-label="Cozivara Living Home">
        <div class="relative w-12 h-12 rounded-full overflow-hidden border border-cozi-taupe/40 shadow-xs group-hover:scale-105 transition-transform duration-300 bg-[#FAF7F2] shrink-0">
          <img 
            src="/images/logo.jpg" 
            alt="Cozivara Living Logo" 
            class="w-full h-full object-cover"
            width="48"
            height="48"
            loading="eager"
          />
        </div>
        <div class="flex flex-col justify-center">
          <span class="font-serif text-2xl font-bold tracking-tight text-cozi-charcoal leading-tight group-hover:text-cozi-olive transition-colors">
            Cozivara
          </span>
          <span class="font-sans text-[10px] tracking-[0.28em] uppercase text-cozi-charcoal/70 font-semibold leading-none mt-0.5">
            LIVING
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links & Social Actions -->
      <div class="hidden lg:flex items-center space-x-6 xl:space-x-8">
        <!-- Main Navigation Links -->
        <nav class="flex items-center space-x-6 xl:space-x-7" aria-label="Main Navigation">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <div class="relative py-2">
                <a 
                  href={link.href}
                  class:list={[
                    "text-sm font-medium transition-colors hover:text-cozi-olive py-1",
                    isActive ? "text-cozi-charcoal font-semibold" : "text-cozi-charcoal/75"
                  ]}
                >
                  {link.name}
                </a>
                {isActive && (
                  <div class="absolute bottom-0 left-0 w-full h-[2px] bg-cozi-charcoal rounded-full animate-in"></div>
                )}
              </div>
            );
          })}
        </nav>

        <!-- Right Side: Social Media Icons & Search -->
        <div class="flex items-center space-x-2.5 pl-4 border-l border-cozi-border/80 text-cozi-charcoal/75">
          <!-- Pinterest -->
          <a 
            href="https://pinterest.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2 hover:text-[#E60023] hover:bg-cozi-border/40 rounded-full transition-all"
            aria-label="Follow Cozivara Living on Pinterest"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026l.032-.026z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a 
            href="https://instagram.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2 hover:text-[#E4405F] hover:bg-cozi-border/40 rounded-full transition-all"
            aria-label="Follow Cozivara Living on Instagram"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.79-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- Search Trigger -->
          <button 
            id="search-trigger-nav" 
            type="button"
            class="p-2 hover:text-cozi-olive hover:bg-cozi-border/40 rounded-full transition-all cursor-pointer"
            aria-label="Search articles"
          >
            <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Right Controls -->
      <div class="flex items-center gap-1.5 lg:hidden">
        <a 
          href="https://pinterest.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 text-cozi-charcoal/75 hover:text-[#E60023]"
          aria-label="Pinterest"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026l.032-.026z"/>
          </svg>
        </a>

        <button 
          id="search-trigger-mobile" 
          type="button"
          class="p-2 text-cozi-charcoal/75 hover:text-cozi-olive"
          aria-label="Search articles"
        >
          <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>

        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 text-cozi-charcoal focus:outline-hidden" 
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6 stroke-current fill-none stroke-2 menu-icon-open" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 stroke-current fill-none stroke-2 menu-icon-close hidden" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-cozi-border bg-cozi-bg px-4 pt-3 pb-6 space-y-2">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a 
          href={link.href}
          class:list={[
            "block px-3 py-2.5 rounded-lg text-base font-medium transition-colors",
            isActive ? "bg-cozi-cream text-cozi-charcoal font-semibold" : "text-cozi-charcoal/80 hover:bg-cozi-cream/50"
          ]}
        >
          {link.name}
        </a>
      );
    })}
    <div class="pt-4 border-t border-cozi-border/70 flex items-center justify-around text-cozi-charcoal/75 text-sm">
      <a href="https://pinterest.com" target="_blank" rel="noopener noreferrer" class="hover:text-cozi-olive p-2 flex items-center gap-1.5" aria-label="Pinterest">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026l.032-.026z"/></svg>
        Pinterest
      </a>
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-cozi-olive p-2 flex items-center gap-1.5" aria-label="Instagram">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.79-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        Instagram
      </a>
      <a href="/about" class="hover:text-cozi-olive p-2">About</a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.querySelector('.menu-icon-open');
  const iconClose = document.querySelector('.menu-icon-close');

  if (menuBtn && menu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
