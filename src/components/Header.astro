---
// src/components/Header.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: '3D Room Planner', href: '/design-my-room' },
  { name: 'Small Spaces', href: '/category/small-spaces' },
  { name: 'Budget Decor', href: '/category/budget-decor' },
  { name: 'Home Organization', href: '/category/home-organization' },
  { name: 'Bedroom', href: '/category/bedroom-ideas' },
  { name: 'Lifestyle', href: '/category/lifestyle' },
  { name: 'About', href: '/about' },
];
---

<header class="sticky top-0 z-40 bg-cozi-bg/95 backdrop-blur-md border-b border-cozi-border/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Logo Branding (Neatly aligned) -->
      <a href="/" class="flex items-center gap-3.5 group shrink-0" aria-label="Cozivara Living Home">
        <div class="relative w-12 h-12 rounded-full overflow-hidden border border-cozi-taupe/40 shadow-xs group-hover:scale-105 transition-transform duration-300 bg-[#FAF7F2] shrink-0">
          <img
            src="/images/logo.jpg"
            alt="Cozivara Living Logo"
            class="w-full h-full object-cover"
            width="48"
            height="48"
            loading="eager"
          />
        </div>
        <div class="flex flex-col justify-center">
          <span class="font-serif text-2xl font-bold tracking-tight text-cozi-charcoal leading-tight group-hover:text-cozi-olive transition-colors">
            Cozivara
          </span>
          <span class="font-sans text-[10px] tracking-[0.28em] uppercase text-cozi-charcoal/70 font-semibold leading-none mt-0.5">
            LIVING
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links & Social Actions -->
      <div class="hidden lg:flex items-center space-x-6 xl:space-x-8">
        <!-- Main Navigation Links -->
        <nav class="flex items-center space-x-6 xl:space-x-7" aria-label="Main Navigation">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <div class="relative py-2">
                <a
                  href={link.href}
                  class:list={[
                    "text-sm font-medium transition-colors hover:text-cozi-olive py-1",
                    isActive ? "text-cozi-charcoal font-semibold" : "text-cozi-charcoal/75"
                  ]}
                >
                  {link.name}
                </a>
                {isActive && (
                  <div class="absolute bottom-0 left-0 w-full h-[2px] bg-cozi-charcoal rounded-full animate-in"></div>
                )}
              </div>
            );
          })}
        </nav>

        <!-- Right Side: Social Media Icons & Search -->
        <div class="flex items-center space-x-2.5 pl-4 border-l border-cozi-border/80 text-cozi-charcoal/75">
          <!-- Pinterest -->


          <!-- Instagram -->


          <!-- Search Trigger -->
          <button
            id="search-trigger-nav"
            type="button"
            class="p-2 hover:text-cozi-olive hover:bg-cozi-border/40 rounded-full transition-all cursor-pointer"
            aria-label="Search articles"
          >
            <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Right Controls -->
      <div class="flex items-center gap-1.5 lg:hidden">


        <button
          id="search-trigger-mobile"
          type="button"
          class="p-2 text-cozi-charcoal/75 hover:text-cozi-olive"
          aria-label="Search articles"
        >
          <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 text-cozi-charcoal focus:outline-hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6 stroke-current fill-none stroke-2 menu-icon-open" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 stroke-current fill-none stroke-2 menu-icon-close hidden" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-cozi-border bg-cozi-bg px-4 pt-3 pb-6 space-y-2">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class:list={[
            "block px-3 py-2.5 rounded-lg text-base font-medium transition-colors",
            isActive ? "bg-cozi-cream text-cozi-charcoal font-semibold" : "text-cozi-charcoal/80 hover:bg-cozi-cream/50"
          ]}
        >
          {link.name}
        </a>
      );
    })}
    <div class="pt-4 border-t border-cozi-border/70 flex items-center justify-around text-cozi-charcoal/75 text-sm">


      <a href="/about" class="hover:text-cozi-olive p-2">About</a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.querySelector('.menu-icon-open');
  const iconClose = document.querySelector('.menu-icon-close');

  if (menuBtn && menu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
