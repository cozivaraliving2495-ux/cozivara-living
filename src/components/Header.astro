---
// src/components/Header.astro
import BrandLockup from './BrandLockup.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/blog' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];

const categoryLinks = [
  { name: 'Small Spaces', href: '/category/small-spaces' },
  { name: 'Budget Decor', href: '/category/budget-decor' },
  { name: 'Home Organization', href: '/category/home-organization' },
  { name: 'Bedroom Ideas', href: '/category/bedroom-ideas' },
  { name: 'Lifestyle', href: '/category/lifestyle' },
];
---

<header class="sticky top-0 z-40 border-b border-cozi-border/80 bg-cozi-bg/95 shadow-[0_4px_20px_-16px_rgba(43,37,35,0.28)] backdrop-blur-md">
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex h-[4.5rem] items-center justify-between gap-5 sm:h-[5rem]">

      <!-- Logo Branding (Neatly aligned) -->
      <a href="/" class="group shrink-0 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive focus-visible:ring-offset-4" aria-label="Cozivara Living home">
        <BrandLockup />
      </a>

      <!-- Desktop Navigation Links & Social Actions -->
      <div class="hidden items-center gap-5 lg:flex xl:gap-7">
        <!-- Main Navigation Links -->
        <nav class="flex items-center gap-4 xl:gap-6" aria-label="Main navigation">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <div class="relative py-2">
                <a
                  href={link.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'rounded-md py-2 text-[13px] font-medium transition-colors hover:text-cozi-olive focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive',
                    isActive ? 'text-cozi-olive' : 'text-cozi-charcoal/75',
                  ]}
                >
                  {link.name}
                </a>
                {isActive && (
                  <div class="absolute inset-x-0 bottom-0 h-0.5 rounded-full bg-cozi-olive"></div>
                )}
              </div>
            );
          })}
          <details class="group relative py-2">
            <summary class:list={[
              'flex cursor-pointer list-none items-center gap-1 rounded-md py-2 text-[13px] font-medium transition-colors hover:text-cozi-olive focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive [&::-webkit-details-marker]:hidden',
              categoryLinks.some((link) => currentPath.startsWith(link.href)) ? 'text-cozi-olive' : 'text-cozi-charcoal/75',
            ]}>
              Explore
              <svg viewBox="0 0 20 20" class="size-3.5 transition-transform group-open:rotate-180" fill="none" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-60 rounded-2xl border border-cozi-border bg-white p-2 shadow-hover">
              {categoryLinks.map((link) => (
                <a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined} class="block rounded-xl px-3.5 py-2.5 text-sm text-cozi-charcoal/80 transition-colors hover:bg-cozi-bg hover:text-cozi-olive focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive">
                  {link.name}
                </a>
              ))}
            </div>
          </details>
        </nav>

        <div class="flex items-center gap-3 border-l border-cozi-border/80 pl-5 text-cozi-charcoal/75">
          <a href="/design-my-room" class="rounded-full bg-cozi-olive px-4 py-2.5 text-[12px] font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-cozi-olive-dark hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive focus-visible:ring-offset-2 xl:px-5 xl:text-[13px]">
            Design a Room
          </a>
          <button
            id="search-trigger-nav"
            type="button"
            class="grid size-9 cursor-pointer place-items-center rounded-full transition-colors hover:bg-cozi-cream hover:text-cozi-olive focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive"
            aria-label="Search articles"
          >
            <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Right Controls -->
      <div class="flex items-center gap-1.5 lg:hidden">


        <button
          id="search-trigger-mobile"
          type="button"
          class="grid size-10 place-items-center rounded-full text-cozi-charcoal/75 transition-colors hover:bg-cozi-cream hover:text-cozi-olive focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive"
          aria-label="Search articles"
        >
          <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          type="button"
          class="grid size-10 place-items-center rounded-full text-cozi-charcoal transition-colors hover:bg-cozi-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive"
          aria-label="Open navigation menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6 stroke-current fill-none stroke-2 menu-icon-open" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 stroke-current fill-none stroke-2 menu-icon-close hidden" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <nav id="mobile-menu" class="hidden border-t border-cozi-border bg-cozi-bg px-4 pb-6 pt-3 shadow-[0_12px_20px_-20px_rgba(43,37,35,0.5)] lg:hidden" aria-label="Mobile navigation">
    <div class="mx-auto grid max-w-7xl gap-1 sm:grid-cols-2">
    {[navLinks[0], { name: '3D Room Planner', href: '/design-my-room' }, navLinks[1], ...categoryLinks, navLinks[2], navLinks[3]].map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'block rounded-xl px-3.5 py-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cozi-olive',
            isActive ? 'bg-cozi-cream text-cozi-olive' : 'text-cozi-charcoal/80 hover:bg-cozi-cream/60',
          ]}
        >
          {link.name}
        </a>
      );
    })}
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.querySelector('.menu-icon-open');
  const iconClose = document.querySelector('.menu-icon-close');

  if (menuBtn && menu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menuBtn.setAttribute('aria-label', isExpanded ? 'Open navigation menu' : 'Close navigation menu');
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.setAttribute('aria-label', 'Open navigation menu');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        menu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.setAttribute('aria-label', 'Open navigation menu');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuBtn.focus();
      }
    });
  }
</script>
