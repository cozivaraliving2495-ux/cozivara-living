---
// src/components/NewsletterBox.astro
---

<section class="py-12 sm:py-16 bg-cozi-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Newsletter Container with Soft Natural Border and Warm Background -->
    <div class="relative rounded-3xl bg-[#F3EFE9] border border-cozi-border overflow-hidden p-8 sm:p-12 lg:p-14 shadow-soft">
      
      <!-- Botanical Leaf SVG Accent (Left side) -->
      <div class="absolute -left-6 -bottom-8 pointer-events-none opacity-30 sm:opacity-50 w-44 h-44 text-cozi-olive">
        <svg viewBox="0 0 200 200" fill="currentColor">
          <path d="M40 180 C30 140, 20 80, 70 30 C90 10, 130 10, 140 40 C150 70, 130 110, 100 130 C70 150, 50 170, 40 180 Z" />
          <path d="M60 160 C55 120, 60 70, 100 35 C110 55, 100 90, 80 120 C70 135, 65 150, 60 160 Z" opacity="0.4" />
          <path d="M30 130 C40 100, 70 70, 110 65 C100 90, 75 110, 50 125 Z" opacity="0.6" />
        </svg>
      </div>

      <!-- Main Layout Grid -->
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left / Center Content -->
        <div class="lg:col-span-8">
          <span class="inline-block text-xs font-semibold tracking-[0.25em] uppercase text-cozi-charcoal/70 mb-2">
            STAY INSPIRED
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-cozi-charcoal tracking-tight mb-3">
            Get Fresh Ideas, DIY Tips & More
          </h2>
          <p class="font-sans text-sm sm:text-base text-cozi-charcoal/80 max-w-xl leading-relaxed mb-6">
            Join our newsletter and be the first to know about new posts, exclusive tips, and home decor inspiration.
          </p>

          <!-- Subscription Form -->
          <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-lg">
            <input 
              type="email" 
              name="email"
              required 
              placeholder="Your email address" 
              class="flex-grow px-5 py-3.5 rounded-full bg-white border border-cozi-border text-sm text-cozi-charcoal placeholder-cozi-charcoal/50 focus:outline-hidden focus:border-cozi-olive focus:ring-2 focus:ring-cozi-olive/20 transition-all shadow-xs"
            />
            <button 
              type="submit" 
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-cozi-olive hover:bg-cozi-olive-dark text-white font-medium text-sm transition-all duration-300 shadow-sm hover:shadow-md transform hover:-translate-y-0.5 whitespace-nowrap cursor-pointer"
            >
              <span>Subscribe</span>
              <svg class="w-4 h-4 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </form>

          <p id="newsletter-status" class="hidden text-xs text-cozi-olive font-medium mt-3 flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            Thank you for subscribing! Check your inbox for our cozy decor starter guide.
          </p>
        </div>

        <!-- Right Side: Graphic Visual (Mug on books) -->
        <div class="hidden lg:flex lg:col-span-4 justify-end">
          <div class="relative group">
            <div class="w-64 h-52 rounded-2xl overflow-hidden shadow-soft border border-cozi-border/80 bg-white p-2">
              <img 
                src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80" 
                alt="Cozy coffee mug and books" 
                class="w-full h-full object-cover rounded-xl transition-transform duration-500 group-hover:scale-105"
                width="250"
                height="200"
                loading="lazy"
              />
            </div>
            <!-- Decorative Tag Pill -->
            <div class="absolute -bottom-3 -left-3 bg-white/95 backdrop-blur-xs px-3.5 py-1.5 rounded-full border border-cozi-border text-[11px] font-serif font-bold text-cozi-charcoal shadow-xs">
              ☕ Good Things Ahead
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form');
  const status = document.getElementById('newsletter-status');

  if (form && status) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('opacity-50', 'pointer-events-none');
      status.classList.remove('hidden');
    });
  }
</script>
