---
// src/components/TableOfContents.astro
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{headings && headings.length > 0 && (
  <nav class="my-8 rounded-2xl bg-white border border-cozi-border p-6 shadow-soft">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-6 h-6 rounded-md bg-cozi-olive/15 text-cozi-olive flex items-center justify-center">
        <svg class="w-3.5 h-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
      </div>
      <h3 class="font-serif text-lg font-bold text-cozi-charcoal">
        In This Article
      </h3>
    </div>

    <ul class="space-y-2.5 text-sm">
      {headings.map((heading) => (
        <li class:list={[
          heading.depth > 2 ? "pl-4 text-xs" : ""
        ]}>
          <a 
            href={`#${heading.slug}`}
            class="text-cozi-charcoal/80 hover:text-cozi-olive transition-colors flex items-center gap-2 group"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-cozi-taupe group-hover:bg-cozi-olive transition-colors"></span>
            <span class="group-hover:underline underline-offset-4">{heading.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
